* text=auto
*.sh text eol=lf
*.py text eol=lf
collision_repair.hpp text eol=lf

# Preserve evidence bytes so recorded SHA256 values survive Windows checkouts.
docs/collision_validation/* -text
# Unified diffs intentionally prefix empty context lines with a space.
docs/collision_validation/*.patch -whitespace
docs/collision_repair/* -text
docs/collision_repair/*.patch -whitespace
